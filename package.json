{
  "name": "streetkey-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Streetkey \u2014 See Beyond the Property. AI property intelligence platform (prototype)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "a11y": "node scripts/a11y-audit.cjs",
    "server:dev": "tsx watch server/src/index.ts",
    "server:start": "node server/dist/index.js",
    "server:build": "esbuild server/src/index.ts server/src/bin/migrate.ts server/src/bin/seed.ts server/src/bin/job.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=server/dist --out-extension:.js=.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "server:test": "vitest run --config server/vitest.config.ts",
    "server:typecheck": "tsc -p server/tsconfig.json",
    "build:all": "npm run build && npm run server:build",
    "db:migrate": "tsx server/src/bin/migrate.ts",
    "db:seed": "tsx server/src/bin/seed.ts",
    "job": "tsx server/src/bin/job.ts",
    "db:migrate:prod": "node server/dist/bin/migrate.js",
    "job:prod": "node server/dist/bin/job.js",
    "db:seed:prod": "node server/dist/bin/seed.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
