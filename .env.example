# Streetkey server settings. Copy to .env for local development (never commit real values).
# On Render these are set in the dashboard; render.yaml declares them.

# --- core ---
NODE_ENV=development
PORT=8787
# The address people use to reach the site, e.g. https://www.streetkey.co.uk (used in emails and to block cross-site requests)
PUBLIC_URL=http://localhost:8787
DATABASE_URL=postgres://streetkey:streetkey@localhost:5432/streetkey
# Set to true if your database host requires TLS and doesn't provide a CA (most managed hosts on external URLs)
DATABASE_SSL=false
# Extra web origins allowed to call the API with cookies (comma separated). Leave empty when the server serves the site.
ALLOWED_ORIGINS=

# --- email (Resend: https://resend.com). Without a key, emails are printed to the log instead of sent. ---
RESEND_API_KEY=
EMAIL_FROM=Streetkey <hello@your-domain.co.uk>

# --- AI room redesign (OpenAI image editing). Without a key the feature is shown as switched off. ---
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_INPUT_FIDELITY=high
AI_DAILY_IMAGES_PER_USER=10

# --- photo storage: local disk (default) or any S3-compatible bucket (Cloudflare R2, AWS S3) ---
STORAGE_DRIVER=local
UPLOAD_DIR=server/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
MAX_PHOTO_MB=12

# --- operations ---
# Private listings wait for an admin to approve them before going live
MODERATE_OWNER_LISTINGS=true
# First admin account, created by `npm run db:seed` (ADMIN_PASSWORD only needed when creating a new account)
ADMIN_EMAIL=
ADMIN_PASSWORD=
LOG_LEVEL=info
