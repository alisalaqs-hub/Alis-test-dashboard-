# Streetkey settings. On Netlify, add these under Site configuration → Environment variables.
# For local development copy this file to .env (never commit real values).

# ── Core ─────────────────────────────────────────────────────────────────────
# The address people use (Netlify sets URL automatically; set this once you have your own domain)
PUBLIC_URL=
# PostgreSQL. On Netlify, Netlify Database sets NETLIFY_DB_URL automatically; or paste any Postgres URL here (e.g. Neon).
DATABASE_URL=
# Verify the database TLS certificate (leave true for Neon / Netlify Database)
DATABASE_SSL_VERIFY=true

# ── AI (OpenAI) ──────────────────────────────────────────────────────────────
# Required for every AI feature. Create one at platform.openai.com → API keys, and set a monthly spend limit there.
OPENAI_API_KEY=
# Turn every AI feature off without redeploying code (the site falls back to its built-in rules)
AI_DISABLED=false
# Models: leave blank and Streetkey picks the best your account can use. Override only if you need to.
OPENAI_MODEL=
OPENAI_FAST_MODEL=
OPENAI_VISION_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_IMAGE_QUALITY=medium
# Limits that protect your OpenAI bill (all per rolling 24 hours)
AI_DAILY_IMAGES_PER_USER=10
AI_DAILY_IMAGES_SITE=300
AI_DAILY_REQUESTS_PER_USER=200
AI_DAILY_REQUESTS_PER_IP=60
# Tokens one signed-in person, or one visitor network (IPv6 /64), may use. Safety checks don't count. 0 = no cap.
AI_DAILY_TOKENS_PER_USER=250000
AI_DAILY_TOKENS_PER_IP=60000
# Site-wide safety net (0 = no cap). Ordinary AI features pause at 85% of it; the last 15% is kept for
# trust reviews and enquiry screening. If OpenAI reports the account is out of credit, AI pauses for
# 10 minutes at a time, the admin gets one email, and the site uses its built-in rules meanwhile.
AI_DAILY_TOKEN_BUDGET=3000000
# Publish low-risk private listings automatically after the AI trust review (default: an admin approves every listing)
AI_AUTO_APPROVE_LOW_RISK=false

# ── Email (Resend: resend.com). Without a key, emails are written to the function log instead. ──
RESEND_API_KEY=
EMAIL_FROM=Streetkey <hello@your-domain.co.uk>

# ── Operations ───────────────────────────────────────────────────────────────
# Private listings wait for admin approval (recommended)
MODERATE_OWNER_LISTINGS=true
# First admin account, created by `npm run db:seed` (password only needed when creating a new account)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Storage (Netlify uses Netlify Blobs automatically; these are for other hosts) ──
# STORAGE_DRIVER=local | s3 | netlify-blobs
STORAGE_DRIVER=
UPLOAD_DIR=server/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Local development only ──
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
